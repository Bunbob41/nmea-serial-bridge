# Serial Link headless — environment overrides for systemd or run-headless.sh
# Copy to /etc/serial-link/headless.env or ~/.config/serial-link/headless.env

# Install directory (systemd WorkingDirectory)
INSTALL_DIR=/opt/serial-link

# Site config JSON (preferred over CLI flags in ExecStart)
CONFIG_FILE=/etc/serial-link/bridge.json

# Optional inline overrides (beat values in bridge.json when set)
# SERIAL_LINK_SERIAL=/dev/ttyUSB0
# SERIAL_LINK_BAUD=115200
# SERIAL_LINK_UDP_PORT=10110
# SERIAL_LINK_NMEA_MODE=passthrough
# SERIAL_LINK_WEB_PORT=8765
# SERIAL_LINK_LAN_BIND=true
# SERIAL_LINK_TOKEN=your-long-random-token
# SERIAL_LINK_AUTOSTART=false
