[Unit]
Description=Serial Link headless bridge + web dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Set INSTALL_DIR to your extract/clone path (see headless.env.example)
EnvironmentFile=-/etc/serial-link/headless.env
EnvironmentFile=-%h/.config/serial-link/headless.env
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=%E{INSTALL_DIR}
ExecStart=%E{INSTALL_DIR}/packaging/linux/run-headless.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
